<?xml version="1.0" encoding="UTF-8"?>
<!--
  Forked from kbdaddid_subscribe's setup/Product.wxs for this project (formerly LayerDriver, renamed
  to kasane / かさね in 2026-10).
  Renames: kbdaddid -> kbdlayer, product name "kbdaddid Subscription" -> "LayerDriver Subscription"
  -> "kasane Subscription" (ja: "かさね Subscription", localized via !(loc.ProductName)).
  The UpgradeCode is unchanged across the rename, so a LayerDriver installation is upgraded in place.
  Internal identifiers stay kbdlayer: the driver service (kbdlayer / kbdlayer.sys), the license pipe
  and %ProgramData%\kbdlayer-license (license state survives the upgrade).
  All fixed/hardcoded GUIDs below (UpgradeCode, Component Guids) are NEW; none of kbdaddid's own
  GUIDs are reused, so the two products can be installed side by side and upgrade independently.
  mouaddid (mouse driver) support removed entirely: no F_MouDriver feature, no MOUDRIVERDIR,
  no MOU_DEVICEIDMODE, no CA_Install/UninstallMouDriver; this product has no mouse component.
  DriverTestApp is not shipped (superseded by KeymapTool.exe, driver/KeymapTool/; CMP_DriverTestApp
  was removed along with its ComponentRef in F_Main). KeymapTool.exe ships alongside
  DriverManager.exe in CMP_DriverTools (added once driver/KeymapTool/ existed).
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="!(loc.ProductName)"
    Language="$(var.ProductLanguage)"
    Version="1.0.1"
    Manufacturer="Applet LLC"
    UpgradeCode="{063E6B2B-BA90-43AA-A5D5-D3B98E10C37B}">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <!--
      AllowSameVersionUpgrades="yes": Version をビルドのたびに上げ忘れて同じ値のままでも、
      同バージョンのインストールでアップグレード（旧製品の除去→新規インストール）を発火させる。
    -->
    <MajorUpgrade
      DowngradeErrorMessage="!(loc.DowngradeError)"
      AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      このドライバは x64 Windows 10 1903（ビルド 18362）以上でのみビルド・検証されている。
      Package の Platform="x64" だけではビルド番号の下限までは検査されないため、ここで補う。
      未検証の組み合わせでカーネルドライバを読み込むと BSOD や入力処理の静かな破損に
      つながりかねないため、インストール開始前（ファイルコスト計算より前）にブロックする。
      Installed を OR しているのは、インストール済み環境からの修復/アンインストールを
      このチェックで妨げないため（WiX の Condition 要素の定石）。
    -->
    <Property Id="WINBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="RS_WinBuildNumber" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>

    <Condition Message="This is the wrong Windows version. It's for Windows 11.">
      Installed OR (VersionNT64 AND WINBUILDNUMBER &gt;= 18362)
    </Condition>

    <!--
      言語別（en-US/ja-JP）に個別ビルドされるMSIそれぞれの利用許諾本文。
      WixVariable の Value は light.exe の loc文字列置換（!(loc.X)）の対象外
      （ファイルパス解決はcandle.exeのプリプロセッサ変数展開でのみ行われる）ため、
      ここは !(loc.X) ではなく $(var.LicenseRtfFile)（wixproj側でCultureごとに /p: 指定）を使う。
    -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.MSBuildProjectDirectory)\$(var.LicenseRtfFile)" />
    <!-- 完了ダイアログで、再起動後にライセンス管理GUIが自動起動する（CMP_RunOnceLicenseGui）ことを
         案内する。既定の完了文言のままだと再起動の必要性もGUIの自動起動もユーザーに伝わらない。
         これはWixVariableではなくWIXUI_EXITDIALOGOPTIONALTEXTプロパティで設定する（ExitDlgの
         OptionalTextコントロールが参照しているのはこのプロパティであり、WixVariable
         "WixUIExitDialogOptionalText" というIdはWixUIの実装が認識しない）。 -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.ExitDialogOptionalText)" />
    <!-- WiX既定の装飾画像（このプロダクトに無関係な汎用画像）を、ウィザード各画面のバナー帯右上で
         app.ico のアートワークに差し替える。Assets\banner.bmp は493x58 24bpp（WiXのバナー標準
         サイズ）で、app.icoを右上44x44に配置し背景はダイアログと同じ白一色で生成したもの。
         手描きではないので、app.icoを差し替えたら再生成すること。 -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.MSBuildProjectDirectory)\Assets\banner.bmp" />

    <Icon Id="ICO_App" SourceFile="$(var.MSBuildProjectDirectory)\..\kasane-license\Resources\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="ICO_App" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />

    <!--
      環境変数 KASANE（データフォルダ。空なら従来の %LOCALAPPDATA%\applet\kasane）。DataDirDlg で表示・変更する。
      管理者保護では昇格したプロセスが別ユーザーで動き %LOCALAPPDATA% が分かれるため、マシン全体の環境変数で保存先を固定できるようにする
      （docs/ADMIN-PROTECTION.md）。現在のマシン環境変数の値を初期値として読み、空のままなら変数には触れない。
      サイレントインストールでは KASANE_DIR=D:\kasane-data のように渡せる。
    -->
    <Property Id="KASANE_DIR" Secure="yes">
      <RegistrySearch Id="RS_KasaneDir" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
                      Name="KASANE" Type="raw" />
    </Property>

    <!--
      インストール時の設定ファイルの取り込み（ImportSettingsDlg。既定はオフ）。IMPORT_SETTINGS=1 のとき、IMPORT_SETTINGS_FILE（kasane が書き出した
      *.kasane.json）の内容を、ドライバのレジストリ（LayerMaps\M_<ModelKey>）へ書く。管理者保護の環境では、インストール後に「適用」できない場合があり、
      インストール時の管理者権限で反映するためのもの。すでに設定があれば置き換え、前の設定は「.bak」に1世代だけ退避する（設定画面から戻せる）。
      KASANE のフォルダを指定しているときは、同じファイルをそのフォルダへ kasane-import.json として置き、設定画面・トレイの分は、起動時に設定の無いものだけ取り込む。
      サイレントインストールでは IMPORT_SETTINGS=1 IMPORT_SETTINGS_FILE=C:\path\x.kasane.json のように渡せる。
    -->
    <Property Id="IMPORT_SETTINGS" Secure="yes" />
    <Property Id="IMPORT_SETTINGS_FILE" Secure="yes" />
    <Property Id="IMPORT_FILE_OK" Secure="yes" />
    <Property Id="IMPORT_FILE_ARG" Secure="yes" />

    <UIRef Id="WixUI_FeatureTree" />
    <!-- これが無いとWindows 10以降ではProgressDlgが未置換のActionTextテンプレート
         （"Copying new files File: [1], Directory: [9], Size: [6]"）をそのまま表示する
         （WiX既知の不具合 wixtoolset/issues#5697、本インストーラー固有の問題ではない）。 -->
    <UIRef Id="WixUI_ErrorProgressText" />

    <!--
      機能ツリー（CustomizeDlg）の直後に DataDirDlg を挿入する。
      WixUI_FeatureTree が内部で公開している既定の遷移
      （CustomizeDlg.Next -> VerifyReadyDlg は Ordering=1、
      VerifyReadyDlg.Back -> CustomizeDlg は Condition="NOT Installed OR WixUI_InstallMode = "Change""
      で Ordering=1、他に Installed 分岐が Ordering=2/3 で存在）を、
      同じ Dialog/Control/Event・同じ Condition のまま、より大きな Ordering 値で上書きする。
      ControlEvent Table の仕様（learn.microsoft.com/windows/win32/msi/controlevent-table）:
      「同一コントロールに複数の NewDialog/SpawnDialog イベントが（Conditionを満たして）
      "selected" された場合、Ordering 値が最大のものだけが発火する」。
      そのため CustomizeDlg.Next 側は既存の Ordering=1 より大きい Ordering="2" を、
      VerifyReadyDlg.Back 側は既存最大の Ordering=3（Installed AND PATCH 分岐）より大きい
      Ordering="4" を明示し、確実にこちらが選ばれるようにする
      （小さい値を選ぶと逆に既存行が勝ち、本ダイアログが一切表示されなくなる）。
      VerifyReadyDlg.Back 側は元の Condition をそのまま踏襲することで、
      メンテナンス/パッチ時の Back 遷移（Ordering=2/3 行）には影響させない。
    -->
    <UI>
      <!-- 設定フォルダ（環境変数 KASANE）。機能ツリー（CustomizeDlg）の次、ImportSettingsDlg の前。 -->
      <Dialog Id="DataDirDlg" Width="370" Height="270" Title="!(loc.DataDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}!(loc.DataDirDlg_Title)</Text>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.DataDirDlg_Description)" />

        <Control Id="Explain" Type="Text" X="25" Y="52" Width="330" Height="75" Text="!(loc.DataDirDlg_Explain)" />

        <Control Id="DirLabel" Type="Text" X="25" Y="135" Width="330" Height="10" Text="!(loc.DataDirDlg_Label)" />
        <Control Id="KasaneDirEdit" Type="Edit" X="25" Y="147" Width="320" Height="15" Property="KASANE_DIR" Sunken="yes" />
        <Control Id="DirHint" Type="Text" X="25" Y="168" Width="330" Height="30" Text="!(loc.DataDirDlg_Hint)" />

        <Control Id="Back" Type="PushButton" X="192" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="CustomizeDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="248" Y="243" Width="56" Height="17" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="ImportSettingsDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <!-- 設定ファイルの取り込み（既定オフ）。DataDirDlg の次、VerifyReadyDlg の前。Next で、ファイルがあるか確かめる。 -->
      <Dialog Id="ImportSettingsDlg" Width="370" Height="270" Title="!(loc.ImportSettingsDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}!(loc.ImportSettingsDlg_Title)</Text>
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.ImportSettingsDlg_Description)" />

        <Control Id="Explain" Type="Text" X="25" Y="52" Width="330" Height="62" Text="!(loc.ImportSettingsDlg_Explain)" />

        <Control Id="ImportCheck" Type="CheckBox" X="25" Y="120" Width="330" Height="18" Property="IMPORT_SETTINGS" CheckBoxValue="1" Text="!(loc.ImportSettingsDlg_Check)" />
        <Control Id="ImportLabel" Type="Text" X="40" Y="144" Width="315" Height="10" Text="!(loc.ImportSettingsDlg_Label)" />
        <Control Id="ImportFileEdit" Type="Edit" X="40" Y="156" Width="305" Height="15" Property="IMPORT_SETTINGS_FILE" Sunken="yes">
          <Condition Action="disable">NOT IMPORT_SETTINGS</Condition>
          <Condition Action="enable">IMPORT_SETTINGS</Condition>
        </Control>
        <Control Id="ImportHint" Type="Text" X="40" Y="178" Width="315" Height="50" Text="!(loc.ImportSettingsDlg_Hint)" />

        <Control Id="Back" Type="PushButton" X="192" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="DataDirDlg">1</Publish>
        </Control>
        <Control Id="Next" Type="PushButton" X="248" Y="243" Width="56" Height="17" Text="!(loc.WixUINext)">
          <Publish Event="DoAction" Value="CA_CheckImportFile" Order="1">IMPORT_SETTINGS</Publish>
          <Publish Event="SpawnDialog" Value="ImportFileMissingDlg" Order="2">IMPORT_SETTINGS AND NOT IMPORT_FILE_OK</Publish>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="3">NOT IMPORT_SETTINGS OR IMPORT_FILE_OK</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Dialog Id="ImportFileMissingDlg" Width="260" Height="85" Title="!(loc.ImportFileMissingDlg_Title)">
        <Control Id="Text" Type="Text" X="25" Y="15" Width="215" Height="35" Text="!(loc.ImportFileMissingDlg_Text)" />
        <Control Id="Ok" Type="PushButton" X="102" Y="57" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="DataDirDlg" Order="2">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ImportSettingsDlg" Order="4">NOT Installed OR WixUI_InstallMode = "Change"</Publish>
    </UI>

    <!--
      KBDDRIVERDIR配下をx64\/arm64\の2階層に分けている。ARM64ネイティブのkbdlayer.sysをx64版と
      同居させ、DriverManager.exe（実行時にIsWow64Process2でホストの実アーキを判定する
      ArchSubdirName()ヘルパーを使う）が正しい方のINF/SYS/CATを選んでインストールできるようにする。
    -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <!-- Program Files\applet\kasane。当社の他のアプリも applet の下に入れる。 -->
        <Directory Id="APPLETFOLDER" Name="applet">
        <Directory Id="INSTALLFOLDER" Name="kasane">
          <Directory Id="KBDDRIVERDIR" Name="kbdlayer">
            <Directory Id="KBDDRIVERDIR_X64" Name="x64" />
            <Directory Id="KBDDRIVERDIR_ARM64" Name="arm64" />
          </Directory>
          <Directory Id="SYMBOLDIR" Name="Symbol" />
          <Directory Id="LICENSESVCDDIR" Name="license-svc" />
          <Directory Id="LICENSEGUIDIR" Name="license-gui" />
          <Directory Id="KEYMAPGUIDIR" Name="keymap-gui" />
          <Directory Id="TRAYDIR" Name="tray" />
          <Directory Id="SAMPLESDIR" Name="samples" />
          <Directory Id="THIRDPARTYDIR" Name="third-party" />
        </Directory>
        </Directory>
      </Directory>
      <!-- スタートメニュー: applet\かさね Subscription（英語版は applet\kasane Subscription） -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppletMenuFolder" Name="applet">
          <Directory Id="KasaneMenuFolder" Name="!(loc.ProductName)" />
        </Directory>
      </Directory>
    </Directory>

    <!--
      F_Main: DriverTools（DriverManager.exe）は常に必須。
      F_KbdDriver: kbdlayer ドライバ（QMK/VIAレイヤーキーマップエンジンの核心）。
      F_LicenseSvc: ライセンス管理サービス（kasane-license-svc.exe）。
      F_LicenseGui: ライセンス管理 GUI（kasane-license.exe）。
    -->
    <Feature Id="F_Main" Title="kasane Subscription Core" Level="1" Absent="disallow">
      <ComponentRef Id="CMP_DriverTools" />
      <ComponentRef Id="CMP_DriverToolsArm64" />
      <ComponentRef Id="CMP_Shortcuts" />
      <ComponentGroupRef Id="CG_Symbol" />
      <!-- サードパーティノーティス（THIRD-PARTY-NOTICES.txt）と、各ライセンスのファイル（third-party\）。HarvestDirectory で収穫（KasaneSetup.wixproj）。 -->
      <ComponentGroupRef Id="CG_Notices" />
      <ComponentGroupRef Id="CG_ThirdParty" />
    </Feature>

    <Feature Id="F_KbdDriver" Title="Keyboard Driver (kbdlayer)" Level="1" Absent="disallow">
      <ComponentGroupRef Id="CG_KbdDriver_X64" />
      <ComponentGroupRef Id="CG_KbdDriver_ARM64" />
    </Feature>

    <!--
      F_Tray: タスクトレイ常駐ツール（kasane-tray.exe = uiAccess=true 版。uiAccess の無い kasane-tray-nua.exe も置く）。ログイン時に自動起動する（HKLM の Run に登録するので、
      すべてのユーザーで起動する）。左クリックでエディタ、右クリックでメニュー（設定・一時停止・ライセンス・終了）。
    -->
    <Feature Id="F_Tray" Title="Tray (kasane-tray)" Level="1" Absent="disallow">
      <ComponentRef Id="CMP_KasaneDirEnv" />
      <ComponentRef Id="CMP_TrayExe" />
      <ComponentRef Id="CMP_TrayNuaExe" />
      <ComponentRef Id="CMP_SiriusHookDll" />
    </Feature>

    <Feature Id="F_LicenseSvc" Title="License Service" Level="1" Absent="disallow">
      <ComponentRef Id="CMP_LicenseSvcExe" />
    </Feature>

    <Feature Id="F_LicenseGui" Title="License Manager" Level="1" Absent="disallow">
      <ComponentRef Id="CMP_LicenseGuiExe" />
      <ComponentRef Id="CMP_RunOnceLicenseGui" />
    </Feature>

    <!--
      F_KeymapGui: キーマップ編集GUI（kasane.exe + Layouts\*.json）と、
      KeymapTool用のサンプルキーマップ（samples\）。どちらもHarvestDirectoryで自動収穫
      （KasaneSetup.wixproj）。スタートメニューのショートカットはCMP_Shortcuts側にある。
    -->
    <Feature Id="F_KeymapGui" Title="Keymap Editor" Level="1" Absent="disallow">
      <ComponentGroupRef Id="CG_KeymapGui" />
      <ComponentGroupRef Id="CG_Samples" />
    </Feature>

    <!-- DriverTools: DriverManager.exe（ドライバインストール用ツール）+ KeymapTool.exe（keymap.json適用/キャリブレーション用CLI） -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="CMP_DriverTools" Guid="{B0ACCA91-C5EA-4FB3-9000-93B07B8721AE}">
        <File Id="FIL_DriverManagerExe" Source="$(var.MSBuildProjectDirectory)\staging\tools\Driver\DriverManager.exe" KeyPath="yes" />
        <File Id="FIL_KeymapToolExe" Source="$(var.MSBuildProjectDirectory)\staging\tools\Driver\KeymapTool.exe" />
      </Component>
      <!--
        DriverManager_arm64.exe: ネイティブARM64ビルド。SetupInstallServicesFromInfSectionW
        （サービス登録）はホストと同一アーキのネイティブプロセスからでないと拒否されるため
        （DriverStoreへのステージング=DiInstallDriverWはx64エミュレーションでも成功するが、
        サービス登録は不可。実機検証済み）、x64版DriverManager.exeがARM64ホストを検出した際に
        丸ごとこのバイナリへリレーする（DriverManager.cppのRelaunchViaArm64Companion）。
        FIL_DriverManagerExeと同じCMP_DriverToolsコンポーネントの別ファイルとして同居させ、
        必ず同じフォルダにインストールされるようにする。
      -->
      <Component Id="CMP_DriverToolsArm64" Guid="{1E02503D-428F-49DA-AA89-8D724344BE3B}">
        <File Id="FIL_DriverManagerArm64Exe" Source="$(var.MSBuildProjectDirectory)\staging\tools\Driver\DriverManager_arm64.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      License Service: kasane-license-svc.exe（単一ファイル publish）
      ServiceInstall は exe と同じ Component に含めることで WiX が ImagePath を自動設定する。
      ServiceControl: インストール時に自動起動、アンインストール時に停止・削除。
    -->
    <DirectoryRef Id="LICENSESVCDDIR">
      <Component Id="CMP_LicenseSvcExe" Guid="{DFEE663A-6644-4464-AD96-A264A7692DCE}">
        <File Id="FIL_LicenseSvcExe"
              Source="$(var.StagingLicenseSvc)\kasane-license-svc.exe"
              KeyPath="yes" />
        <!-- appsettings.json: Gumroad:ProductPermalink など設定値を保持 -->
        <File Id="FIL_LicenseSvcConfig"
              Source="$(var.StagingLicenseSvc)\appsettings.json" />
        <ServiceInstall
          Id="SVC_KbdLayerLicense"
          Name="kasaneLicenseSvc"
          DisplayName="kasane License Service"
          Description="!(loc.LicenseSvcDescription)"
          Type="ownProcess"
          Start="auto"
          ErrorControl="normal"
          Account="LocalSystem" />
        <ServiceControl
          Id="SVC_KbdLayerLicense_Ctrl"
          Name="kasaneLicenseSvc"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </DirectoryRef>

    <!-- Tray: kasane-tray.exe（単一ファイル publish）。Run キーでログイン時に自動起動する。 -->
    <DirectoryRef Id="TRAYDIR">
      <Component Id="CMP_TrayExe" Guid="{7D2E9B54-3A61-4C8F-B0E2-5F1A6C93D8A7}">
        <File Id="FIL_TrayExe"
              Source="$(var.StagingTray)\kasane-tray.exe"
              KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="kasane-tray"
                       Value="&quot;[TRAYDIR]kasane-tray.exe&quot;"
                       Type="string" />
      </Component>
    </DirectoryRef>

    <!--
      天狼（sirius）のフック用 DLL（IME の状態を TSF で読む。sirius\ フォルダ）。トレイが exe と同じフォルダから読み込み、全 GUI プロセスに注入する。
      注入された DLL は各プロセスに居座る（自分を固定する）ので、更新・アンインストールのときに「使用中」になり、再起動が要ることがある。
      設定で「IMM32 のみ」を選ぶと、フックを入れない（DLL は置いてあるだけ）。
    -->
    <DirectoryRef Id="TRAYDIR">
      <Component Id="CMP_SiriusHookDll" Guid="{7FF5DCD7-2A33-4E55-93AD-B6B61CEEAE3C}">
        <File Id="FIL_SiriusHookDll"
              Source="$(var.StagingTray)\sirius_hook_for_kasane_x64.dll"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      環境変数 KASANE（マシン全体）。KASANE_DIR が空でないときだけ作る。アンインストールで削除される。
      変更後に起動するプロセスから有効（Windows Installer が WM_SETTINGCHANGE を通知するが、既に動いているトレイは再ログインまで古い値のまま）。
    -->
    <DirectoryRef Id="TRAYDIR">
      <Component Id="CMP_KasaneDirEnv" Guid="{2B7C4E19-8D53-4A6F-9E01-C5F3A8D27B64}" KeyPath="yes">
        <Condition>KASANE_DIR &lt;&gt; ""</Condition>
        <Environment Id="ENV_Kasane" Name="KASANE" Value="[KASANE_DIR]"
                     Action="set" Part="all" System="yes" Permanent="no" />
      </Component>
    </DirectoryRef>

    <!--
      uiAccess の無い版のトレイ（kasane-tray-nua.exe。置くだけで、Run キーには登録しない）。kasane-tray.exe（uiAccess=true）は、署名が信頼されない・
      Program Files の外から起動した、などで起動に失敗すると、何も表示されずに終わる。そのとき、利用者がこちらを手で起動する（docs/HELPER.md）。
      単一起動の mutex は両方で共通。
    -->
    <DirectoryRef Id="TRAYDIR">
      <Component Id="CMP_TrayNuaExe" Guid="{C4A8E1B7-52D9-4F36-9A0E-7B3D6F81E2C5}">
        <File Id="FIL_TrayNuaExe"
              Source="$(var.StagingTray)\kasane-tray-nua.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- License GUI: kasane-license.exe（単一ファイル publish） -->
    <DirectoryRef Id="LICENSEGUIDIR">
      <Component Id="CMP_LicenseGuiExe" Guid="{205AF696-E36B-46A0-AA2E-E06061FD492E}">
        <File Id="FIL_LicenseGuiExe"
              Source="$(var.StagingLicenseGui)\kasane-license.exe"
              KeyPath="yes" />
      </Component>
      <!--
        ライセンス管理GUIを次回ログイン時に一度だけ自動起動する。ドライバのUpperFilters登録は
        再起動しないと反映されないため、インストール直後にこのままアクティベートしても機能は
        有効化されない（ライセンストークン自体は書き込まれるが、ドライバがそれを読むのは次の
        AddDevice＝次回デバイス構築時）。再起動後、ユーザーが自分でランチャーを探さなくても
        アクティベート画面が自動的に出てくるようにする。
        HKLM の RunOnce はWindowsが実行後に自動的にキーを削除するため、アンインストール時の
        後始末は不要（既に消えているか、消えていなければ実行されずに残るだけで無害）。
      -->
      <Component Id="CMP_RunOnceLicenseGui" Guid="{6C0AF239-6078-4FBF-AF79-9B73E4535821}">
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\RunOnce"
                       Name="kasaneLicense"
                       Value="&quot;[LICENSEGUIDIR]kasane-license.exe&quot;"
                       Type="string" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- スタートメニューショートカット -->
    <DirectoryRef Id="KasaneMenuFolder">
      <Component Id="CMP_Shortcuts" Guid="{3A444FE9-C76E-47A9-BC5B-D7E42A15765A}">
        <Shortcut Id="ShortcutLicenseGui" Name="kasane License Manager"
                  Target="[LICENSEGUIDIR]kasane-license.exe"
                  WorkingDirectory="LICENSEGUIDIR"
                  Icon="ICO_App" />
        <Shortcut Id="ShortcutKeymapGui" Name="!(loc.ShortcutKeymapName)"
                  Target="[KEYMAPGUIDIR]kasane.exe"
                  WorkingDirectory="KEYMAPGUIDIR"
                  Icon="ICO_App" />
        <!--
          トレイ（uiAccess=true 版）。トレイを終了したあと、次のログオンを待たずに起動し直せるようにする。スタートメニューは
          シェル（エクスプローラー）経由の起動なので uiAccess が付く。二重起動は mutex（Local\kasane-tray）で止まる。
          uiAccess の無い版（kasane-tray-nua.exe）は、救済用に手で起動するもので、ショートカットにしない。
        -->
        <Shortcut Id="ShortcutTray" Name="!(loc.ShortcutTrayName)"
                  Target="[TRAYDIR]kasane-tray.exe"
                  WorkingDirectory="TRAYDIR"
                  Icon="ICO_App" />
        <RemoveFolder Id="KasaneMenuFolder" On="uninstall" />
        <!-- applet フォルダは他のアプリと共有するので、空のときだけ消える（RemoveFolder は空でなければ何もしない）。 -->
        <RemoveFolder Id="AppletMenuFolder" Directory="AppletMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\applet\kasane" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!--
      アンインストール前にインストールフォルダを完全削除するクリーンアップ。
      CA_SetCleanupPath（immediate）が INSTALLFOLDER の値を
      CA_CleanupInstallDir（deferred）の CustomActionData として渡す。
      アップグレード時（UPGRADINGPRODUCTCODE が設定される）はスキップし
      ユーザー設定ファイルを保護する。スタンドアロンアンインストール時のみ実行。
    -->
    <CustomAction
      Id="CA_SetCleanupPath"
      Property="CA_CleanupInstallDir"
      Value="[INSTALLFOLDER]"
      Execute="immediate" />

    <CustomAction
      Id="CA_CleanupInstallDir"
      Script="vbscript"
      Execute="deferred"
      Return="ignore"
      Impersonate="no"><![CDATA[
On Error Resume Next
Dim d,f
d=Session.Property("CustomActionData")
If Len(d)>0 Then
Set f=CreateObject("Scripting.FileSystemObject")
If f.FolderExists(d) Then f.DeleteFolder d,True
Set f=Nothing
End If
]]></CustomAction>

    <!-- 取り込みファイルの確認（ImportSettingsDlg の Next。immediate）。貼り付けた「"」は外す（エクスプローラーの「パスのコピー」は、"" で囲んで返す）。 -->
    <CustomAction Id="CA_CheckImportFile" Script="vbscript" Execute="immediate" Return="ignore"><![CDATA[p=Replace(Session.Property("IMPORT_SETTINGS_FILE"),Chr(34),""):Session.Property("IMPORT_SETTINGS_FILE")=p:Session.Property("IMPORT_FILE_OK")="":If CreateObject("Scripting.FileSystemObject").FileExists(p) Then Session.Property("IMPORT_FILE_OK")="1"]]></CustomAction>

    <!--
      KASANE のフォルダの用意（deferred、SYSTEM）。kasane.exe のヘッドレスコマンド（prepare-data-dir）。無ければ作り、Users に変更権限を付ける
      （標準ユーザーのトレイ・設定画面が、設定を保存できるように。すでにあるフォルダの権限は触らない）。取り込むときは、選んだファイルを、そのフォルダに
      kasane-import.json として置く（設定画面・トレイが、起動時に設定の無いものだけ取り込む）。
      フォルダは「[KASANE_DIR]\.」の形で渡す（末尾が \ のとき、コマンドラインの「\"」が引用符として解釈されるのを避ける）。
      取り込まないときは、ファイルの引数を空にする（IMPORT_SETTINGS が 1 のときだけ渡す）。
    -->
    <CustomAction
      Id="CA_PrepareKasaneDir"
      Directory="KEYMAPGUIDIR"
      ExeCommand="&quot;[KEYMAPGUIDIR]kasane.exe&quot; --prepare-data-dir &quot;[KASANE_DIR]\.&quot; &quot;[IMPORT_FILE_ARG]&quot;"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />
    <CustomAction Id="CA_SetImportFileArg" Property="IMPORT_FILE_ARG" Value="[IMPORT_SETTINGS_FILE]" Execute="immediate" />

    <!--
      設定ファイルの内容を、ドライバのレジストリへ書く（deferred、SYSTEM）。kasane.exe のヘッドレスモード（install-import コマンド）。ファイルが無い・形式が違うなど、
      失敗してもインストールは続ける（Return="ignore"）。結果は %ProgramData%\applet\kasane\import.log。ドライバが動いていなくても書ける。
      書いた設定は、キーボードが接続されたとき（再起動後・接続し直し）にドライバが読み込む。
    -->
    <CustomAction
      Id="CA_ImportDriverSettings"
      Directory="KEYMAPGUIDIR"
      ExeCommand="&quot;[KEYMAPGUIDIR]kasane.exe&quot; --install-import &quot;[IMPORT_SETTINGS_FILE]&quot;"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <!--
      DeviceIdMode は渡さない（インストーラーでは選ばせない）。kbdlayer.sys は、レジストリに値が無ければ
      0（DeviceId = DeviceInstanceId のハッシュ）で動く（docs/DEVICE-ID.md）。
    -->
    <CustomAction
      Id="CA_InstallKbdDriver"
      FileKey="FIL_DriverManagerExe"
      ExeCommand="install keyboard"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <CustomAction
      Id="CA_UninstallKbdDriver"
      FileKey="FIL_DriverManagerExe"
      ExeCommand="uninstall keyboard"
      Execute="deferred"
      Return="ignore"
      Impersonate="no" />

    <!--
      起動中のトレイを終了する。起動中のままだとファイルを入れ替え・削除できず（再起動まで残る）、
      旧版のトレイが動き続けるため。アップグレード（RemoveExistingProducts）・アンインストール・修復の前に行う。
      Return="ignore": 起動していなければ taskkill が失敗するが、それは問題ではない。
      トレイは次回のログインで自動起動する（Run キー）。
    -->
    <CustomAction
      Id="CA_StopTray"
      Directory="TARGETDIR"
      ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM kasane-tray.exe /IM kasane-tray-nua.exe"
      Execute="immediate"
      Return="ignore" />

    <!--
      前のアンインストールの後、再起動する前に再インストールすると、サービス kbdlayer が「削除予約済み」のままで、INF によるサービスの作成が
      ERROR_SERVICE_MARKED_FOR_DELETE (1072) で失敗し、インストールが最後（CA_InstallKbdDriver）で巻き戻る（2026-10-11 に発生）。
      レジストリ（DeleteFlag）にはこの状態が出ないので、DriverManager.exe check-pending が SCM に問い合わせる（削除予約済みなら終了コード 1072）。
      DriverManager.exe は管理者権限が必須なので、Deferred（SYSTEM）で実行する。まだインストール先に無いので、MSI に埋め込んだもの（Binary）を使う。
      失敗すると、Product.*.wxl の Error1722 の文言（「再起動してから、もう一度」）が出て、何も変更せずに巻き戻る。
    -->
    <Binary Id="BIN_DriverManager" SourceFile="$(var.MSBuildProjectDirectory)\staging\tools\Driver\DriverManager.exe" />
    <CustomAction
      Id="CA_CheckKbdPendingDelete"
      BinaryKey="BIN_DriverManager"
      ExeCommand="check-pending"
      Execute="deferred"
      Return="check"
      Impersonate="no" />

    <!-- 外部プログラム（Return="check" の exe）の失敗の文言（エラー 1722）は、WixUI の Overridable な文字列 Error1722 を、
         Product.*.wxl で同じ Id を定義して上書きする（Error 要素で足すと、WixUI の定義と重複してリンクに失敗する）。 -->

    <!-- InstallFiles is not atomic in the deferred script: Before InstallFinalize runs after all file operations have been scripted. -->
    <InstallExecuteSequence>
      <Custom Action="CA_StopTray" Before="RemoveExistingProducts" />
      <Custom Action="CA_CheckKbdPendingDelete" After="InstallInitialize">NOT REMOVE~="ALL" AND &amp;F_KbdDriver=3</Custom>
      <Custom Action="CA_InstallKbdDriver" Before="InstallFinalize">NOT REMOVE~="ALL" AND &amp;F_KbdDriver=3</Custom>
      <!-- 取り込み（任意）。ドライバのインストールのあと、kasane.exe が置かれたあとに行う。 -->
      <Custom Action="CA_SetImportFileArg" Before="InstallInitialize">NOT REMOVE~="ALL" AND KASANE_DIR &lt;&gt; "" AND IMPORT_SETTINGS="1"</Custom>
      <Custom Action="CA_PrepareKasaneDir" Before="InstallFinalize">NOT REMOVE~="ALL" AND KASANE_DIR &lt;&gt; ""</Custom>
      <Custom Action="CA_ImportDriverSettings" After="CA_InstallKbdDriver">NOT REMOVE~="ALL" AND IMPORT_SETTINGS="1" AND IMPORT_SETTINGS_FILE &lt;&gt; ""</Custom>
      <ScheduleReboot After="CA_ImportDriverSettings">NOT REMOVE~="ALL" AND &amp;F_KbdDriver=3</ScheduleReboot>

      <!--
        アップグレード（MajorUpgrade による旧製品の自動削除）時はドライバをアンインストールしない。
        UPGRADINGPRODUCTCODE は RemoveExistingProducts が旧製品を削除する際に旧製品側へ設定される
        プロパティで、この直後に新製品側の CA_InstallKbdDriver が "install" コマンドで既存ドライバを
        上書き更新する（DriverManager.exe の InstallDriver は既存サービス・DriverStore・
        UpperFiltersの上書き更新に対応済み）。毎回 ProductCode が変わり同一バージョンでも
        MajorUpgrade が発火する構成のため、このガードが無いと上書きインストールのたびに
        ドライバの削除→再作成が発生し、稼働中のフィルタドライバを不要に着脱することになっていた。
        スタンドアロンのアンインストール（コントロールパネル等からの削除）では
        UPGRADINGPRODUCTCODE が立たないため、従来通りドライバも完全に削除される。
      -->
      <Custom Action="CA_UninstallKbdDriver" Before="RemoveFiles">REMOVE~="ALL" AND !F_KbdDriver=3 AND NOT UPGRADINGPRODUCTCODE</Custom>

      <!--
        RemoveFiles 完了後に残存ファイル・ディレクトリを削除。
        CA_SetCleanupPath は immediate なので Before="InstallInitialize" でプロパティを確定させる。
        アップグレード時（UPGRADINGPRODUCTCODE が設定される）はスキップしユーザー設定ファイルを保護する。
      -->
      <Custom Action="CA_SetCleanupPath" Before="InstallInitialize">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CA_CleanupInstallDir" After="RemoveFiles">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
