<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ja-jp" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="ProductName">かさね Subscription</String>
  <String Id="ShortcutKeymapName">かさね</String>
  <String Id="ShortcutTrayName">かさね Tray</String>
  <String Id="DowngradeError">新しいバージョンのかさね Subscription がすでにインストールされています。</String>
  <String Id="Error1722">セットアップの一部として実行されたプログラムが正常に終了しませんでした。直前にかさねをアンインストールした場合は、コンピューターを再起動してから、もう一度インストールしてください。ライセンスキーを入力する版では、キーが正しいことと、インターネットに接続できていることも確かめてください。それでも失敗するときは、サポート担当者に問い合わせてください。（エラー 1722 {{、処理: [2]、場所: [3]、コマンド: [4]}}）</String>
  <String Id="ProductNamePro">かさね Pro</String>
  <String Id="DowngradeErrorPro">新しいバージョンのかさね Pro がすでにインストールされています。</String>
  <String Id="ExitDialogOptionalTextPro">インストールを完了するには、コンピューターを再起動してください。</String>
  <String Id="OtherEditionInstalled">かさね Pro がインストールされています。同じコンピューターに、Subscription と Pro は同時にインストールできません。</String>
  <String Id="OtherEditionInstalledPro">かさね Subscription がインストールされています。先にかさね Subscription をアンインストールし、コンピューターを再起動してから、もう一度インストールしてください。</String>
  <String Id="LicenseKeyDlg_Title">ライセンスキーの入力</String>
  <String Id="LicenseKeyDlg_Description">Gumroad で購入したライセンスキーを入力してください</String>
  <String Id="LicenseKeyDlg_Explain">キーの確認は、インストール時に1回だけ行います。インターネットに接続している必要があります。確認できないときは、インストールを中止して、何も変更しません。</String>
  <String Id="LicenseKeyDlg_Label">ライセンスキー:</String>
  <String Id="LicenseKeyDlg_Hint">マウスの右クリックは利用できないので、キーボードを使用して、Ctrl+Vで貼り付けてください。</String>
  <String Id="LicenseKeyEmptyDlg_Title">ライセンスキーがありません</String>
  <String Id="LicenseKeyEmptyDlg_Text">ライセンスキーを入力してください。</String>
  <String Id="LicenseSvcDescription">かさね サブスクリプションライセンス管理</String>
  <String Id="ExitDialogOptionalText">インストールを完了するには、コンピューターを再起動してください。再起動後にログインすると、ライセンス管理ツールが自動的に起動します。</String>

  <String Id="DataDirDlg_Title">設定フォルダの指定</String>
  <String Id="DataDirDlg_Description">環境変数 KASANE で、設定ファイルの保存先を固定できます</String>
  <String Id="DataDirDlg_Explain">設定ファイルの保存フォルダを指定します。空欄の場合には、各ユーザーの %LOCALAPPDATA%\applet\kasane を使います。ドライブ文字から始まるフルパスで指定してください。「参照...」でフォルダを選べます。パスを貼り付けるときは、右クリックが使えないので、Ctrl+V を使ってください。</String>
  <String Id="DataDirDlg_Label">設定フォルダ（環境変数 KASANE）:</String>
  <String Id="DataDirDlg_Browse">参照...</String>
  <String Id="DataDirDlg_BrowseTitle">設定フォルダを選んでください</String>
  <String Id="ImportSettingsDlg_Title">設定ファイルの取り込み</String>
  <String Id="ImportSettingsDlg_Description">kasane で書き出した設定を、ドライバに反映します（任意）</String>
  <String Id="ImportSettingsDlg_Explain">kasane のエクスポートで書き出した設定ファイル(*.kasane.json)を指定可能です。ライセンスが有効な場合、再起動後(またはキーボードを接続し直したとき)から有効になります。</String>
  <String Id="ImportSettingsDlg_Check">設定ファイルを取り込む</String>
  <String Id="ImportSettingsDlg_Label">設定ファイル（フルパス）:</String>
  <String Id="ImportSettingsDlg_Hint">マウスの右クリックは利用できないので、キーボードを使用して、Ctrl+Vで貼り付けてください。</String>
  <String Id="ImportSettingsDlg_RecoveryFound">設定フォルダにあった復旧用のファイル（kasane-recovery.kasane.json）を選びました。取り込まないときは、チェックを外してください。</String>
  <String Id="ImportFileMissingDlg_Title">設定ファイルが見つかりません</String>
  <String Id="ImportFileMissingDlg_Text">指定した設定ファイルが見つかりません。パスを確かめるか、「設定ファイルを取り込む」のチェックを外してください。</String>
</WixLocalization>
