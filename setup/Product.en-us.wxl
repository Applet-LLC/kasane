<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="ProductName">kasane Subscription</String>
  <String Id="ShortcutKeymapName">kasane</String>
  <String Id="ShortcutTrayName">kasane Tray</String>
  <String Id="DowngradeError">A newer version of kasane Subscription is already installed.</String>
  <String Id="Error1722">A program run as part of the setup did not finish as expected. If you have just uninstalled kasane, restart the computer and run the installer again. If this edition asks for a license key, also check that the key is correct and that the computer is connected to the internet. If it still fails, contact support. (Error 1722 {{, action: [2], location: [3], command: [4]}})</String>
  <String Id="ProductNamePro">kasane Pro</String>
  <String Id="DowngradeErrorPro">A newer version of kasane Pro is already installed.</String>
  <String Id="ExitDialogOptionalTextPro">Restart your computer to complete the installation.</String>
  <String Id="OtherEditionInstalled">kasane Pro is installed. Subscription and Pro cannot be installed on the same computer at the same time.</String>
  <String Id="OtherEditionInstalledPro">kasane Subscription is installed. Uninstall kasane Subscription first, restart the computer, and then run this installer again.</String>
  <String Id="LicenseKeyDlg_Title">Enter your license key</String>
  <String Id="LicenseKeyDlg_Description">Enter the license key you purchased on Gumroad</String>
  <String Id="LicenseKeyDlg_Explain">The key is checked once, during installation. An internet connection is required. If the key cannot be checked, the installation stops and nothing is changed.</String>
  <String Id="LicenseKeyDlg_Label">License key:</String>
  <String Id="LicenseKeyDlg_Hint">The mouse right-click menu is not available here. Use the keyboard and paste with Ctrl+V.</String>
  <String Id="LicenseKeyEmptyDlg_Title">No license key</String>
  <String Id="LicenseKeyEmptyDlg_Text">Enter your license key.</String>
  <String Id="LicenseSvcDescription">kasane subscription license management</String>
  <String Id="ExitDialogOptionalText">Restart your computer to complete the installation. The License Manager will start automatically the next time you sign in.</String>

  <String Id="DataDirDlg_Title">Settings Folder</String>
  <String Id="DataDirDlg_Description">Pin where kasane stores its settings with the KASANE environment variable</String>
  <String Id="DataDirDlg_Explain">Specify the folder where settings files are stored. If left empty, each user's %LOCALAPPDATA%\applet\kasane is used. Enter a full path starting with a drive letter. Choose a folder with Browse..., or paste a path with Ctrl+V (right-click is not available here).</String>
  <String Id="DataDirDlg_Label">Settings folder (environment variable KASANE):</String>
  <String Id="DataDirDlg_Browse">Browse...</String>
  <String Id="DataDirDlg_BrowseTitle">Select the settings folder</String>
  <String Id="ImportSettingsDlg_Title">Import Settings File</String>
  <String Id="ImportSettingsDlg_Description">Apply settings exported from kasane to the driver (optional)</String>
  <String Id="ImportSettingsDlg_Explain">You can specify a settings file (*.kasane.json) exported with kasane's Export. If the license is valid, it takes effect after a restart (or after you reconnect the keyboard).</String>
  <String Id="ImportSettingsDlg_Check">Import a settings file</String>
  <String Id="ImportSettingsDlg_Label">Settings file (full path):</String>
  <String Id="ImportSettingsDlg_Hint">Right-click is not available here, so use the keyboard and paste with Ctrl+V.</String>
  <String Id="ImportSettingsDlg_RecoveryFound">The recovery file (kasane-recovery.kasane.json) found in the settings folder has been selected. Clear the check box if you do not want to import it.</String>
  <String Id="ImportFileMissingDlg_Title">Settings file not found</String>
  <String Id="ImportFileMissingDlg_Text">The settings file was not found. Check the path, or clear "Import a settings file".</String>
</WixLocalization>
