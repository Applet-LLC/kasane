<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="ProductName">kasane Subscription</String>
  <String Id="DowngradeError">A newer version of kasane Subscription is already installed.</String>
  <String Id="LicenseSvcDescription">kasane subscription license management</String>
  <String Id="ExitDialogOptionalText">Restart your computer to complete the installation. The License Manager will start automatically the next time you sign in.</String>

  <String Id="DeviceIdModeDlg_Title">Device Identification Mode</String>
  <String Id="DeviceIdModeDlg_Description">Choose how kbdlayer tells connected devices apart</String>
  <String Id="DeviceIdModeDlg_Explain">Device Instance ID mode distinguishes devices by their USB connection (port). Even identical keyboard models are treated as different devices if the USB port changes. Hardware ID mode distinguishes devices by a device-specific ID, so an identical keyboard is treated as the same device even after you change which USB port it's plugged into.</String>
  <String Id="DeviceIdModeDlg_KbdLabel">Keyboard driver (kbdlayer):</String>
  <String Id="DeviceIdModeDlg_InstancePath">Device Instance ID mode (default) - distinguish by connection</String>
  <String Id="DeviceIdModeDlg_DeviceId">Hardware ID mode - distinguish by device-specific ID</String>
</WixLocalization>
