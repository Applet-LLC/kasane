[Version]
Signature="$Windows NT$"
Class=Keyboard
ClassGuid={4D36E96B-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=kbdlayer.cat
DriverVer=01/01/2026,1.0.0.1
PnpLockdown=1


[DefaultInstall.NTamd64]
CopyFiles=kbdlayer_Files_Driver
AddService=kbdlayer,0x00000002,kbdlayer_Service_Install

[DefaultInstall.NTarm64]
CopyFiles=kbdlayer_Files_Driver
AddService=kbdlayer,0x00000002,kbdlayer_Service_Install

; The upper-filter registration (Keyboard class UpperFilters) is done by DriverManager,
; which inserts kbdlayer below kbdclass at a fixed position relative to known co-installed
; filters. This INF used to also have AddFilter ([DefaultInstall.*.Filters],
; FilterPosition=Upper). When the INF was installed on its own, that added a second
; registration under Class\{GUID}\Filters, so kbdlayer was attached twice to every keyboard
; and processed each key twice (found 2026-09-28). Installing this INF alone does not register
; the filter; use DriverManager (the setup installer) for HLK and other setups as well.

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
kbdlayer.sys=1


[kbdlayer_Files_Driver]
kbdlayer.sys

[DefaultInstall.NTamd64.Services]
AddService=kbdlayer,0x00000002,kbdlayer_Service_Install

[DefaultInstall.NTarm64.Services]
AddService=kbdlayer,0x00000002,kbdlayer_Service_Install

[kbdlayer_Service_Install]
DisplayName    = %ServiceName%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\kbdlayer.sys
Dependencies   = kbdclass

[DefaultUninstall.NTamd64]
LegacyUninstall=1

[DefaultUninstall.NTamd64.Services]
DelService = kbdlayer,0x200

[DefaultUninstall.NTarm64]
LegacyUninstall=1

[DefaultUninstall.NTarm64.Services]
DelService = kbdlayer,0x200

[Strings]
ProviderName="Applet LLC"
DiskName="kbdlayer Installation Disk"
DeviceDesc="kbdlayer Filter Driver"
FilterDesc="kbdlayer Filter"
ServiceName="kbdlayer Service"
