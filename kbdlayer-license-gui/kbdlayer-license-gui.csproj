<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>KbdLayerLicenseGui</RootNamespace>
    <AssemblyName>kbdlayer-license-gui</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- single-file publish: dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <StartupObject>KbdLayerLicenseGui.App</StartupObject>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window.Icon のパック参照解決用（exeファイル自体のアイコンは ApplicationIcon が担当） -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
