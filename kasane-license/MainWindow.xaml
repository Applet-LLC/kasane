<Window x:Class="KasaneLicense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kasane License Manager"
        Icon="Resources/app.ico"
        Width="560" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 手動言語切替（自動判定の上書き）。インストーラ側には置かず、この常駐GUIのみに設置する -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,10,16,0">
            <ComboBox x:Name="CmbLanguage" Width="110"
                      SelectionChanged="CmbLanguage_SelectionChanged">
                <ComboBoxItem x:Name="CmbLanguageJa" Tag="ja"/>
                <ComboBoxItem x:Name="CmbLanguageEn" Tag="en"/>
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20,4,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ライセンス状態表示 -->
            <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtStatus" FontSize="14" FontWeight="Bold"
                                   Foreground="#555555" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtExpiry" Foreground="#666666" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtUser"   Foreground="#666666" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnRefresh" Grid.Column="1"
                            VerticalAlignment="Top"
                            Click="BtnRefresh_Click"/>
                </Grid>
            </Border>

            <!-- ライセンスキー入力（未アクティベート時） -->
            <StackPanel Grid.Row="2" x:Name="PanelActivateInput">
                <TextBlock x:Name="LblLicenseKey" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtLicenseKey" Grid.Column="0"
                             Height="28" VerticalContentAlignment="Center"
                             FontFamily="Consolas" FontSize="13"/>
                    <Button x:Name="BtnActivate" Grid.Column="2"
                            Click="BtnActivate_Click"/>
                </Grid>
            </StackPanel>

            <!-- アクティベート済み表示（マスク済みキー、再入力不可） -->
            <StackPanel Grid.Row="2" x:Name="PanelActivated" Visibility="Collapsed">
                <TextBlock x:Name="LblLicenseKeyRegistered" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtActivatedKey" IsReadOnly="True"
                         Height="28" VerticalContentAlignment="Center"
                         FontFamily="Consolas" FontSize="13"
                         Background="#F2F2F2" Foreground="#555555"/>
            </StackPanel>

            <!-- アクティベート処理中の接続診断 -->
            <StackPanel Grid.Row="4" x:Name="PanelDiagnostics" Visibility="Collapsed">
                <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="10,8">
                    <StackPanel>
                        <TextBlock x:Name="TxtDiagService" FontSize="12"/>
                        <TextBlock x:Name="TxtDiagGumroad" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- エラー・メッセージ -->
            <TextBlock x:Name="TxtMessage" Grid.Row="6"
                       Foreground="#CC0000" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- Gumroad リンク -->
            <StackPanel Grid.Row="8" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="LblPurchase" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="#666666" FontSize="12"/>
                <TextBlock>
                    <Hyperlink x:Name="LinkGumroad" Click="LinkGumroad_Click">
                        <Run x:Name="RunLinkGumroad"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
