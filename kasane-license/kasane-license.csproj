<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>KasaneLicense</RootNamespace>
    <AssemblyName>kasane-license</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- single-file publish: dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <StartupObject>KasaneLicense.App</StartupObject>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\kasane\Interop\SingleInstance.cs" Link="Shared\SingleInstance.cs" />
    <!-- 色のモード（ライト／ダーク）は、kasane と同じものを使う（tray.json の ColorMode）。 -->
    <Compile Include="..\kasane\Model\ColorMode.cs" Link="Shared\ColorMode.cs" />
    <Compile Include="..\kasane\Views\AppTheme.cs" Link="Shared\AppTheme.cs" />
    <Page Include="..\kasane\Themes\Dark.xaml" Link="Themes\Dark.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window.Icon のパック参照解決用（exeファイル自体のアイコンは ApplicationIcon が担当） -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
