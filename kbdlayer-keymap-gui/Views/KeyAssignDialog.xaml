<Window x:Class="KbdLayerKeymapGui.Views.KeyAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="キーの割り当て" Width="760" Height="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock x:Name="TxtHeader" DockPanel.Dock="Top" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="キーコード:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="TxtToken" Grid.Column="1" FontFamily="Consolas" FontSize="14" TextChanged="TxtToken_TextChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="BtnOk" Content="OK" IsDefault="True" Width="80" Click="BtnOk_Click" />
                <Button Content="キャンセル" IsCancel="True" Width="80" />
            </StackPanel>
            <TextBlock x:Name="TxtValidation" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4,0,0" TextWrapping="Wrap" />
        </Grid>

        <ListBox x:Name="LstCategories" DockPanel.Dock="Left" Width="150" Margin="0,0,8,0"
                 SelectionChanged="LstCategories_SelectionChanged" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="CategoryContent" />
        </ScrollViewer>
    </DockPanel>
</Window>
