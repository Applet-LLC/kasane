<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Kasane.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- 参照するkasane本体はwin-x64。AnyCPUのままだとMSB3270（MSILとAMD64の不一致）になる。 -->
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kasane\kasane.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- トレイ（kasane-tray）の一時停止の中身。WinFormsに依存しない2ファイルだけを取り込む
         （kasane-trayをプロジェクト参照すると、KbdLayerClientなどの型がkasaneと重複して曖昧になるため）。 -->
    <Compile Include="..\kasane-tray\PauseController.cs" Link="Tray\PauseController.cs" />
    <Compile Include="..\kasane-tray\DesktopViewMode.cs" Link="Tray\DesktopViewMode.cs" />
    <Compile Include="..\kasane-tray\PauseStateStore.cs" Link="Tray\PauseStateStore.cs" />
    <Compile Include="..\kasane-tray\AutoOffController.cs" Link="Tray\AutoOffController.cs" />
    <Compile Include="..\kasane-tray\AutoOffStore.cs" Link="Tray\AutoOffStore.cs" />
    <Compile Include="..\kasane-tray\ImeLinkController.cs" Link="Tray\ImeLinkController.cs" />
    <Compile Include="..\kasane-tray\Win32ImeSource.cs" Link="Tray\Win32ImeSource.cs" />
    <Compile Include="..\kasane-tray\AppLayerArbiter.cs" Link="Tray\AppLayerArbiter.cs" />
    <Compile Include="..\kasane-tray\AppRuleController.cs" Link="Tray\AppRuleController.cs" />
    <Compile Include="..\kasane-tray\ActionLayerController.cs" Link="Tray\ActionLayerController.cs" />
    <Compile Include="..\kasane-tray\LayerMenuModel.cs" Link="Tray\LayerMenuModel.cs" />
    <Compile Include="..\kasane-tray\LayerDisplay.cs" Link="Tray\LayerDisplay.cs" />
    <Compile Include="..\kasane-tray\LayerWatchService.cs" Link="Tray\LayerWatchService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 10キーのKLEレイアウト（テスト用フィクスチャ）。同梱レイアウトと同じ形式のものを
         テスト専用にコピーし、出力ディレクトリへ配置する。 -->
    <None Include="Fixtures\kle-10key.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>



</Project>
