<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ライト（既定）とダークで共通のスタイル（元は App.xaml にあったもの）。ダークのときは、Dark.xaml が、あとから足されて同じキーのスタイルを上書きする。
      ボタンとコンボボックスは、同じ余白・同じ最小の高さ・上下中央にそろえる（横に並べたとき、OK／キャンセルやコンボボックスと高さが
      食い違わないようにする）。以前は、Margin を個別に書いたボタンだけが上下の余白を失い、縦に引き伸ばされて高さが違っていた。
    -->
    <Style TargetType="Button">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- バナー（閲覧専用モードの案内）の色。ダークでは Dark.xaml が上書きする。 -->
    <SolidColorBrush x:Key="Theme.TextDim" Color="DimGray" />
    <SolidColorBrush x:Key="Theme.BannerBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="Theme.BannerBorder" Color="#E0C060" />
</ResourceDictionary>
