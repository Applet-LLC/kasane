<Window x:Class="Kasane.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:Kasane.Layout"
        Title="kasane" Width="1280" Height="600"
        Icon="/Resources/app.ico"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- 閲覧専用モード（管理者として実行していない）の案内。ドライバは設定の書き換えと
             キーのキャプチャを管理者にしか許さない（kbdlayer_ioctl.h のアクセスビット参照）。 -->
        <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="管理者として再起動" Click="BtnRestartAsAdmin_Click" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="閲覧専用モード: 管理者として実行していないため、キーボードへの適用・キャリブレーション・キーボードの特定はできません（編集・保存・エクスポート・OFFはできます）。" />
            </DockPanel>
        </Border>

        <!-- キーボード（デバイス）とレイアウトの選択 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock Text="キーボード:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="CmbDevice" Width="460" DisplayMemberPath="DisplayName"
                      SelectionChanged="CmbDevice_SelectionChanged" />
            <Button x:Name="BtnIdentify" Content="押して特定..." Click="BtnIdentify_Click"
                    ToolTip="キーを1つ押して、どのキーボードかを選びます" />
            <Button Content="一覧を更新" Click="BtnRefreshDevices_Click" />
            <TextBlock Text="レイアウト:" VerticalAlignment="Center" Margin="20,0,4,0" />
            <ComboBox x:Name="CmbLayout" Width="110" SelectionChanged="CmbLayout_SelectionChanged" />
            <Button x:Name="BtnAddKle" Content="KLEから追加..." Click="BtnLoadKle_Click"
                    ToolTip="keyboard-layout-editor.com で作った配列(JSON)を取り込み、レイアウトの一覧に追加します" />
        </StackPanel>

        <!-- レイヤー選択 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4">
            <TextBlock Text="レイヤー:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ListBox x:Name="LstLayers" SelectionChanged="LstLayers_SelectionChanged" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button Content="＋ 追加" Click="BtnAddLayer_Click" />
            <Button Content="− 最後を削除" Click="BtnRemoveLayer_Click" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtStatus" />
        </StatusBar>

        <WrapPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
            <Button x:Name="BtnCalibrateAll" Content="キャリブレーション（全キー）..." Click="BtnCalibrateAll_Click" />
            <Button x:Name="BtnMacros" Content="マクロ..." Click="BtnMacros_Click" />
            <Button x:Name="BtnCombos" Content="コンボ..." Click="BtnCombos_Click" />
            <Button x:Name="BtnTapDances" Content="タップダンス..." Click="BtnTapDances_Click" />
            <Button x:Name="BtnKeyOverrides" Content="キー置換..." Click="BtnKeyOverrides_Click" />
            <Button x:Name="BtnSettings" Content="設定..." Click="BtnSettings_Click"
                    ToolTip="機能のON/OFF・タイミング・NICOLA・緊急解除・共有範囲" />
            <Separator Width="24" Background="Transparent" />
            <Button x:Name="BtnSave" Content="保存" Click="BtnSave_Click" />
            <Button x:Name="BtnImportExport" Content="インポート／エクスポート..." Click="BtnImportExport_Click"
                    ToolTip="設定をファイル（*.kasane.json）に書き出す・読み込む（全体一括・このキーボード・レイヤー1枚）" />
            <Button x:Name="BtnExport" Content="エクスポート（KeymapTool用JSON）..." Click="BtnExport_Click"
                    ToolTip="KeymapTool --apply-simple に渡す keymap.json / profile.json を書き出す（マクロ・コンボ等は含まれない）。バックアップや受け渡しには「インポート／エクスポート...」を使う" />
            <Separator Width="24" Background="Transparent" />
            <Button x:Name="BtnApply" Content="キーボードに適用（ON）" FontWeight="Bold" Click="BtnApply_Click" />
            <Button x:Name="BtnOff" Content="OFF（素通しに戻す）" Click="BtnOff_Click" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom" Margin="10,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="クリック: 割り当てを変更 ／ 右クリック: キー単位の実測・既定に戻す ／ 青: 既定から変更 ／ 緑: レイヤー・Mod-Tap等 ／ 橙枠: 実測値が既定と異なる ／ 赤枠: スキャンコード不明（要実測） ／ ▽: 下のレイヤーと同じ（透過）" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <layout:KeyboardCanvas x:Name="KbdCanvas" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
