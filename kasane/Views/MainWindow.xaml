<Window x:Class="Kasane.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:Kasane.Layout"
        Title="かさね" Width="1280" Height="600"
        Icon="/Resources/app.ico"
        Initialized="Window_LocalizeInit" Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- 閲覧専用モード（管理者として実行していない）の案内。ドライバは設定の書き換えと
             キーのキャプチャを管理者にしか許さない（kbdlayer_ioctl.h のアクセスビット参照）。 -->
        <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="{DynamicResource Theme.BannerBackground}" BorderBrush="{DynamicResource Theme.BannerBorder}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <Button x:Name="BtnRestartAsAdmin" DockPanel.Dock="Right" Content="管理者として再起動" Click="BtnRestartAsAdmin_Click" />
                <TextBlock x:Name="TxtReadOnlyMessage" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="閲覧専用モード: 管理者として実行していないため、キーボードへの適用・キャリブレーション・キーボードの特定はできません(編集・保存・エクスポート・OFFはできます)。" />
            </DockPanel>
        </Border>

        <!-- キーボード（デバイス）とレイアウトの選択 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
            <TextBlock x:Name="TxtKeyboardLabel" Text="キーボード:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="CmbDevice" Width="620" DisplayMemberPath="DisplayName"
                      SelectionChanged="CmbDevice_SelectionChanged"
                      ToolTip="UniqId、つけた名前、Windows 上の名前(FriendlyName・ShellFriendlyName)、ハードウェアID の順に表示します" />
            <Button x:Name="BtnRenameKeyboard" Content="名前を付ける..." Click="BtnRenameKeyboard_Click"
                    ToolTip="このキーボードに、わかりやすい名前を付けます(設定画面の表示だけに使います)" />
            <Button x:Name="BtnIdentify" Content="押して特定..." Click="BtnIdentify_Click"
                    ToolTip="キーを1つ押して、どのキーボードかを選びます" />
            <Button x:Name="BtnRefreshDevices" Content="一覧を更新" Click="BtnRefreshDevices_Click"
                    ToolTip="接続中のキーボードの一覧を、ドライバから読み直します(キーボードをつなぎ直したあとなどに使います)" />
            <TextBlock x:Name="TxtLayoutLabel" Text="レイアウト:" VerticalAlignment="Center" Margin="20,0,4,0" />
            <ComboBox x:Name="CmbLayout" Width="110" SelectionChanged="CmbLayout_SelectionChanged" />
            <Button x:Name="BtnAddKle" Content="KLEから追加..." Click="BtnLoadKle_Click"
                    ToolTip="keyboard-layout-editor.com で作った配列(JSON)を取り込み、レイアウトの一覧に追加します" />
        </StackPanel>

        <!-- レイヤー選択 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,4">
            <TextBlock x:Name="TxtLayerLabel" Text="レイヤー:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ListBox x:Name="LstLayers" SelectionChanged="LstLayers_SelectionChanged" BorderThickness="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <Button x:Name="BtnAddLayer" Content="＋ 追加" Click="BtnAddLayer_Click" />
            <Button x:Name="BtnRemoveLayer" Content="− 最後を削除" Click="BtnRemoveLayer_Click" />
        </StackPanel>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="TxtStatus" />
        </StatusBar>

        <WrapPanel DockPanel.Dock="Bottom" Margin="8,4,8,8">
            <Button x:Name="BtnCalibrateAll" Content="キャリブレーション..." ToolTip="キーの入力確認、個別キー・全キーのキャリブレーション(最初は入力確認モード)" Click="BtnCalibrateAll_Click" />
            <Button x:Name="BtnHelper" Content="ヘルパー..." Click="BtnHelper_Click"
                    ToolTip="設定の「ヘルパー動作」タブを開く(キーでプログラム起動・文字列入力・アプリ別レイヤーなど)" />
            <Button x:Name="BtnMacros" Content="マクロ..." Click="BtnMacros_Click" />
            <Button x:Name="BtnCombos" Content="コンボ..." Click="BtnCombos_Click" />
            <Button x:Name="BtnTapDances" Content="タップダンス..." Click="BtnTapDances_Click" />
            <Button x:Name="BtnKeyOverrides" Content="キー置換..." Click="BtnKeyOverrides_Click" />
            <Button x:Name="BtnSettings" Content="設定..." Click="BtnSettings_Click"
                    ToolTip="機能のON/OFF・タイミング・NICOLA・緊急解除・共有範囲" />
            <Button x:Name="BtnRemapText" Content="割り当ての一覧..." Click="BtnRemapText_Click"
                    ToolTip="変えた割り当てと、コンボ・マクロなどを、1行ずつ文字で表示します(コピー・保存できます)" />
            <Separator Width="24" Background="Transparent" />
            <Button x:Name="BtnImportExport" Content="インポート／エクスポート..." Click="BtnImportExport_Click"
                    ToolTip="設定をファイル(*.kasane.json)に書き出す・読み込む(全体一括・このキーボード・レイヤー1枚)。「クリア」タブで、選んだ項目を初期状態に戻せます" />
            <Button x:Name="BtnHelp" Content="ヘルプ" Click="BtnHelp_Click"
                    ToolTip="マニュアルを開きます(ブラウザーで表示します。F1 キーでも開けます)" />
            <Separator Width="24" Background="Transparent" />
            <Button x:Name="BtnApply" Content="キーボードに適用(ON)" FontWeight="Bold" Click="BtnApply_Click" />
            <Button x:Name="BtnOff" Content="OFF(素通しに戻す)" Click="BtnOff_Click" />
        </WrapPanel>

        <TextBlock x:Name="TxtLegend" DockPanel.Dock="Bottom" Margin="10,0" Foreground="{DynamicResource Theme.TextDim}" TextWrapping="Wrap"
                   Text="クリック: 割り当てを変更 ／ 右クリック: 実測値を消す・割り当てを戻す・コンボなどを開く ／ 青: 既定から変更 ／ 緑: レイヤー・Mod-Tap等 ／ 右下の印: M=マクロ・D=タップダンス・C=コンボ・R=キー置換(ボタンの( )は定義の数)／ 橙枠: 実測値が既定と異なる ／ 赤枠: スキャンコード不明(要実測) ／ ▽: 下のレイヤーと同じ(透過)" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <layout:KeyboardCanvas x:Name="KbdCanvas" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
