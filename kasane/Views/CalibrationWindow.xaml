<Window x:Class="Kasane.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:Kasane.Layout"
        Title="キャリブレーション" Width="1200" Height="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Initialized="Window_Initialized" Activated="Window_Activated" Deactivated="Window_Deactivated" Closed="Window_Closed">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="TxtModeLabel" Text="モード:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
            <RadioButton x:Name="ModeInputCheck" GroupName="CalibrationMode" Content="入力確認" IsChecked="True"
                         VerticalAlignment="Center" Margin="0,0,18,0" Checked="Mode_Checked"
                         ToolTip="キーを押して、キャリブレーションが要るかを確かめます" />
            <RadioButton x:Name="ModeSingleKey" GroupName="CalibrationMode" Content="個別キー"
                         VerticalAlignment="Center" Margin="0,0,18,0" Checked="Mode_Checked"
                         ToolTip="クリックしたキーだけを実測します(管理者)" />
            <RadioButton x:Name="ModeAllKeys" GroupName="CalibrationMode" Content="全体"
                         VerticalAlignment="Center" Checked="Mode_Checked"
                         ToolTip="黄色のキーを順に押して、全キーを実測します(管理者)" />
        </StackPanel>
        <TextBlock x:Name="TxtInstruction" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="TxtNote" DockPanel.Dock="Top" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextDim}" TextWrapping="Wrap"
                   Text="この画面が前面の間、キーは Windows に届きません" />
        <TextBlock x:Name="TxtLast" DockPanel.Dock="Top" Margin="0,6,0,6" FontSize="13" TextWrapping="Wrap" />

        <DockPanel x:Name="BottomBar" DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BtnResetChecks" Content="確認済みをリセット" Click="BtnResetChecks_Click" />
            <Button x:Name="BtnBack" Content="1つ戻る" Click="BtnBack_Click" />
            <Button x:Name="BtnSkip" Content="このキーを飛ばす" Click="BtnSkip_Click" />
            <Button x:Name="BtnFinish" Content="実測値を保存して閉じる" FontWeight="Bold" Click="BtnFinish_Click" />
            <Button x:Name="BtnCancel" Content="閉じる" Click="BtnCancel_Click" ToolTip="実測値は保存しません" />
        </StackPanel>
        </DockPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <layout:KeyboardCanvas x:Name="KbdCanvas" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
    </DockPanel>
</Window>
