<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KasaneLauncher</RootNamespace>
    <AssemblyName>Install-kasane</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- single-file publish: dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- app.manifest で requireAdministrator を指定（詳細はそちらのコメント参照） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- kasane-license\Resources\app.ico を共有（MSIのARPPRODUCTICONと同一素材） -->
    <ApplicationIcon>..\kasane-license\Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
