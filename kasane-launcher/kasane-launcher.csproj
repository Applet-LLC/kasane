<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\AppVersion.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KasaneLauncher</RootNamespace>
    <AssemblyName>Install-kasane</AssemblyName>
    <!-- 買い切り版(kasane Pro)のランチャー: dotnet publish /p:Edition=Pro。キー入力欄を持ち、MSI にキーを渡す。
         exe 名と obj を分けて、サブスク版の成果物と混ざらないようにする。 -->
    <AssemblyName Condition="'$(Edition)' == 'Pro'">Install-kasane-pro</AssemblyName>
    <DefineConstants Condition="'$(Edition)' == 'Pro'">$(DefineConstants);KASANE_PRO</DefineConstants>
    <IntermediateOutputPath Condition="'$(Edition)' == 'Pro'">obj\Pro\$(Configuration)\</IntermediateOutputPath>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- single-file publish: dotnet publish -c Release -r win-x64 /p:PublishSingleFile=true -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- app.manifest で requireAdministrator を指定（詳細はそちらのコメント参照） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- kasane\Resources\app.ico を共有（MSIのARPPRODUCTICONと同一素材） -->
    <ApplicationIcon>..\kasane\Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
